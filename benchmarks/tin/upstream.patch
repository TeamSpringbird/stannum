@@ -562,10 +562,31 @@ candidate AS MATERIALIZED (
         FROM bounds
     )
     LIMIT 1
+),
+-- Updates can leave a page with no visible tuples. Continue from that page,
+-- then wrap to the heap start, without counting an empty probe as an update.
+forward_candidate AS MATERIALIZED (
+    SELECT document.ctid FROM %s AS document
+    WHERE NOT EXISTS (SELECT 1 FROM candidate)
+      AND document.ctid >= (
+        SELECT format('(%%s,0)', bounds.block)::tid FROM bounds
+      )
+    LIMIT 1
+),
+wrapped_candidate AS MATERIALIZED (
+    SELECT document.ctid FROM %s AS document
+    WHERE NOT EXISTS (SELECT 1 FROM candidate)
+      AND NOT EXISTS (SELECT 1 FROM forward_candidate)
+    LIMIT 1
 )
 UPDATE %s AS document
 SET body = document.body || ' '
-WHERE document.ctid = (SELECT ctid FROM candidate)`, table, table)
+WHERE document.ctid = (
+    SELECT ctid FROM candidate
+    UNION ALL SELECT ctid FROM forward_candidate
+    UNION ALL SELECT ctid FROM wrapped_candidate
+    LIMIT 1
+)`, table, table, table, table)
 }
 
