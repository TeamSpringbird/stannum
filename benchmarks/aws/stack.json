{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Ephemeral PostgreSQL benchmark host; ARM managed-TIN comparison or x86 published-reference baseline. No inbound access.",
  "Parameters": {
    "Ami": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/canonical/ubuntu/server/noble/stable/current/arm64/hvm/ebs-gp3/ami-id"
    },
    "InstanceType": {
      "Type": "String",
      "Default": "r8g.large",
      "AllowedValues": [
        "r8g.large",
        "r7g.large",
        "i7i.8xlarge"
      ]
    },
    "DiskGiB": {
      "Type": "Number",
      "Default": 100,
      "MinValue": 30,
      "MaxValue": 200
    },
    "LifetimeHours": {
      "Type": "Number",
      "Default": 8,
      "MinValue": 1,
      "MaxValue": 12
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.93.0.0/24",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true
      }
    },
    "Gateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {}
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "Gateway"
        }
      }
    },
    "Subnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.93.0.0/26",
        "MapPublicIpOnLaunch": true
      }
    },
    "Routes": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "InternetRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "Routes"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "Gateway"
        }
      },
      "DependsOn": "GatewayAttachment"
    },
    "RouteAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Subnet"
        },
        "RouteTableId": {
          "Ref": "Routes"
        }
      }
    },
    "SecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Temporary benchmark: SSM only, no inbound ports",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupEgress": [
          {
            "IpProtocol": "-1",
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "ec2.amazonaws.com"
                ]
              },
              "Action": [
                "sts:AssumeRole"
              ]
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore"
          }
        ],
        "Policies": [
          {
            "PolicyName": "OwnedBenchmarkArtifacts",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Artifacts",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Artifacts.Arn}/*"
                  }
                }
              ]
            }
          },
          {
            "PolicyName": "ReadPinnedWikipediaCache",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": "arn:aws:s3:::springbird-dev-stannum-corpus-cache-860510875764/f487fbaaf5039a7b92e1de4efb40e0f7c6fcdb86/wikipedia/*"
                }
              ]
            }
          },
          {
            "PolicyName": "ReusableDatabaseSnapshots",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:AbortMultipartUpload"
                  ],
                  "Resource": "arn:aws:s3:::springbird-dev-stannum-corpus-cache-860510875764/postgres-snapshots/*"
                }
              ]
            }
          }
        ]
      }
    },
    "Profile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "Role"
          }
        ]
      }
    },
    "Server": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "Ami"
        },
        "InstanceType": {
          "Ref": "InstanceType"
        },
        "IamInstanceProfile": {
          "Ref": "Profile"
        },
        "SubnetId": {
          "Ref": "Subnet"
        },
        "SecurityGroupIds": [
          {
            "Ref": "SecurityGroup"
          }
        ],
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpEndpoint": "enabled"
        },
        "InstanceInitiatedShutdownBehavior": "terminate",
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Ref": "AWS::StackName"
            }
          },
          {
            "Key": "Purpose",
            "Value": "stannum-tin-benchmark"
          }
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Sub": "#!/bin/bash\nset -euo pipefail\n# Schedule termination before installation so a package failure cannot skip it.\ncat > /etc/systemd/system/benchmark-expiry.service <<'UNIT'\n[Unit]\nDescription=Terminate temporary benchmark instance\n[Service]\nType=oneshot\nExecStart=/usr/sbin/poweroff\nUNIT\ncat > /etc/systemd/system/benchmark-expiry.timer <<'UNIT'\n[Unit]\nDescription=Temporary benchmark lifetime limit\n[Timer]\nOnBootSec=${LifetimeHours}h\nUnit=benchmark-expiry.service\n[Install]\nWantedBy=timers.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable --now benchmark-expiry.timer\nexport DEBIAN_FRONTEND=noninteractive\napt-get update\napt-get install -y docker.io git python3-venv python3-boto3 ca-certificates jq curl unzip postgresql-client\n# A newly created instance owns these otherwise empty instance-store disks.\n# Format only a verified, unmounted Amazon instance-store device, never EBS.\nif [ '${InstanceType}' = 'i7i.8xlarge' ]; then\n  systemctl stop docker.service docker.socket\n  DISK=$(lsblk -dn -o PATH,MODEL | awk '/Amazon EC2 NVMe Instance Storage/ {print $1; exit}')\n  test -n \"$DISK\"\n  test -z \"$(lsblk -n -o MOUNTPOINTS \"$DISK\" | tr -d '[:space:]')\"\n  test -z \"$(blkid -s TYPE -o value \"$DISK\" || true)\"\n  mkfs.ext4 -F \"$DISK\"\n  mkdir -p /mnt/benchmark\n  mount \"$DISK\" /mnt/benchmark\n  UUID=$(blkid -s UUID -o value \"$DISK\")\n  echo \"UUID=$UUID /mnt/benchmark ext4 defaults,nofail 0 2\" >> /etc/fstab\n  mkdir -p /mnt/benchmark/docker /mnt/benchmark/work /etc/docker\n  echo '{\"data-root\":\"/mnt/benchmark/docker\"}' > /etc/docker/daemon.json\n  ln -s /mnt/benchmark/work /opt/stannum-benchmark\nelse\n  install -d -m 0755 /opt/stannum-benchmark\nfi\nsystemctl enable --now docker\nuname -a > /opt/stannum-benchmark/kernel.txt\nlscpu > /opt/stannum-benchmark/cpu.txt\nlsblk -o NAME,SIZE,TYPE,MOUNTPOINTS > /opt/stannum-benchmark/disks.txt\ntouch /opt/stannum-benchmark/bootstrap-ready\n"
          }
        },
        "LaunchTemplate": {
          "LaunchTemplateId": {
            "Ref": "DiskTemplate"
          },
          "Version": {
            "Fn::GetAtt": [
              "DiskTemplate",
              "LatestVersionNumber"
            ]
          }
        }
      },
      "DependsOn": [
        "InternetRoute",
        "RouteAssociation"
      ]
    },
    "DiskTemplate": {
      "Type": "AWS::EC2::LaunchTemplate",
      "Properties": {
        "LaunchTemplateData": {
          "BlockDeviceMappings": [
            {
              "DeviceName": "/dev/sda1",
              "Ebs": {
                "VolumeType": "gp3",
                "VolumeSize": {
                  "Ref": "DiskGiB"
                },
                "Iops": 3000,
                "Throughput": 125,
                "Encrypted": true,
                "DeleteOnTermination": true
              }
            }
          ]
        }
      }
    },
    "Artifacts": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "ExpireTemporaryEvidence",
              "Status": "Enabled",
              "ExpirationInDays": 7,
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Purpose",
            "Value": "stannum-tin-benchmark"
          }
        ]
      }
    }
  },
  "Outputs": {
    "InstanceId": {
      "Value": {
        "Ref": "Server"
      }
    },
    "Region": {
      "Value": {
        "Ref": "AWS::Region"
      }
    },
    "ArtifactBucket": {
      "Value": {
        "Ref": "Artifacts"
      }
    }
  },
  "Conditions": {
    "PublishedHost": {
      "Fn::Equals": [
        {
          "Ref": "InstanceType"
        },
        "i7i.8xlarge"
      ]
    }
  }
}
